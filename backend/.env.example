PORT=3000
NODE_ENV=development

# -- JWT ------------------------------------------------------------------------
# Required. At least 32 random characters; the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# -- Database -------------------------------------------------------------------
# Defaults to backend/data/curry_time.db. Override with an absolute path if needed.
# DB_PATH=./data/curry_time.db

# -- Email / SMTP (optional) ----------------------------------------------------
# Without these the site still works and saves every message and booking to the
# database; it just does not send emails.
# Gmail: turn on 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Address that receives contact form messages and reservation alerts
RESTAURANT_EMAIL=

# -- Hosting --------------------------------------------------------------------
# Origin the site is served from (used for the cross-site request check and CORS)
ALLOWED_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the app. Render: 1. Needed so the rate
# limiter sees each visitor's real address. Leave 0 when running locally.
TRUSTED_PROXY_HOPS=0
