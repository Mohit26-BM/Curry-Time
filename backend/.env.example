PORT=3000
NODE_ENV=development

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Database ───────────────────────────────────────────────────────────────────
# Defaults to backend/data/curry_time.db — override to an absolute path if needed
# DB_PATH=./data/curry_time.db

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Gmail: turn on 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# Address that receives contact form submissions and reservation alerts
RESTAURANT_EMAIL=CurryTimes26@gmail.com

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000
